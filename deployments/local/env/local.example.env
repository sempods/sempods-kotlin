# Personal configuration for a local run. Copy to `local.env` (git-ignored) in this directory.
#
# `SempodsServerStarter` loads it as its very first statement, walking up from the working
# directory — so it works the same from Gradle and from a plain run in an IDE. Entries become
# system properties and the environment always wins, so an exported variable or a `-D` flag
# still overrides what is here.
#
# One line in this file is active; everything else is a default written out so it can be found.
# The defaults reproduce a working local setup against the compose stack next to it.

# Arms the published development admin credential `development:sc_development-admin-secret`,
# which is what the README's quick start presents to the host-level admin routes. Without it
# those routes answer 503 and the quick start stops at the first call.
#
# It is a variable rather than an inference because the secret is published with this source.
# Arming it wherever `PRODUCTION` is not `true` would read a forgotten variable as consent, and
# leave anyone who builds the jar and binds it publicly with an open host-admin surface and a
# credential everyone can read. Unset means fail closed everywhere, this machine included.
# Setting it in production fails the boot rather than being ignored.
SEMPODS_DEV_ADMIN_FALLBACK=true

# Where MongoDB is. Defaults to the compose stack's mapping.
# MONGODB_URL=mongodb://localhost:27018

# The port the server listens on, and the address it is *known by*. The second one is not
# merely reachability: pod IRIs are minted from it, it is the `iss` of every token the pod
# issues, and grants are compared against it byte for byte. Changing it on a running deployment
# does not redirect anything — it starts writing a second set of identities beside the first.
# SEMPODS_HTTP_PORT=8090
# SEMPODS_PUBLIC_BASE_URL=http://localhost:8090/

# Admin credentials for the host-level `_system/admin/…` routes (pod lifecycle, app
# provisioning): comma-separated `clientId:secret` pairs. The check fails closed — with neither
# this nor the fallback above, every admin route answers 503, never 200.
#
# This is what a deployment sets, and it always wins over the fallback.
# Generate a secret per client: openssl rand -base64 32
# SEMPODS_ADMIN_CLIENTS=operator:replace-me

# The natural-language layer, which has no off state: unset means `ollama`, so the AI routes are
# mounted either way and answer `500 ai_provider_error` until an Ollama is reachable. Nothing else
# needs one — the server, the suite and every other route run without a model.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
#
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Pod media. Off by default, which is right for a pod server that holds only RDF. The path is
# required whenever a backend is set: a silent fallback would put binaries somewhere nobody
# backs up, and lose them on the next restart.
# SEMPODS_MEDIA_BACKEND=filesystem
# SEMPODS_MEDIA_PATH=/tmp/sempods-media
